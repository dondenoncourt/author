{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "proxy": "http://localhost:3001",
  "dependencies": {
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/user-event": "^14.4.3",
    "ajv": "^8.17.1",
    "axios": "^1.13.2",
    "bootstrap": "^5.3.8",
    "react": "^16.14.0",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^16.14.0",
    "react-scripts": "5.0.0",
    "web-vitals": "^3.4.0"
  },
  "scripts": {
    "start": "react-scripts start",
    "test": "react-scripts test",
